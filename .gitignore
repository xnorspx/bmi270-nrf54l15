# ---------------------------------------------------------------- Zephyr build
# build.ps1 的輸出，31 MB 以上且每次編譯都會變
build/
.west/
twister-out*/
*.elf
*.hex
*.bin
*.map
*.o
*.d

# ---------------------------------------------------------------- 錄製資料
# 每次採集一個 session_* 目錄，CSV 會長到數百 MB，屬於實驗資料。
# 目錄本身保留，clone 之後仍然存在。
sessions/*
!sessions/.gitkeep

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------- 雜項
_shot*.png
*.log
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
